# PostgreSQL connection string — set automatically by Railway when you add a
# Postgres plugin to your service (available as $DATABASE_URL in Railway dashboard)
DATABASE_URL="postgresql://user:password@host:5432/smartgrocery?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Local development
NEXTAUTH_URL="http://localhost:3000"

# Set in Railway dashboard to your Railway app URL, e.g.
# NEXTAUTH_URL="https://smartgrocery-production.up.railway.app"

# Railway injects PORT automatically — do not hard-code it
# PORT is read by .next/standalone/server.js at runtime
