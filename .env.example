# PostgreSQL connection string from Neon (https://neon.tech)
# Dashboard → your project → Connection Details → select "Prisma" from the dropdown
# It looks like: postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Local development
NEXTAUTH_URL="http://localhost:3000"
# On Vercel set this to your deployment URL in Settings → Environment Variables
# e.g. NEXTAUTH_URL="https://smart-grocery.vercel.app"
